ENVIRONMENT=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chatbot_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_RECYCLE=3600

# Authentication
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:5173

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_USE_REDIS=false
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_CHAT=30/minute
RATE_LIMIT_UPLOAD=20/minute
RATE_LIMIT_OPTIMIZE=10/minute

# LLM and web search
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=llama-3.1-8b-instant
GROQ_PROMPT_OPTIMIZATION_MODEL=openai/gpt-oss-20b
TAVILY_API_KEY=

# Prompt optimization
PROMPT_OPT_ENABLED=true
PROMPT_OPT_TEMPERATURE=0.1
PROMPT_OPT_MAX_TOKENS=2048
PROMPT_OPT_CONNECT_TIMEOUT=3.0
PROMPT_OPT_READ_TIMEOUT=8.0
PROMPT_OPT_MAX_RETRIES=2
PROMPT_OPT_RETRY_BACKOFF_SECONDS=0.5

# Retrieval-augmented generation
RAG_ENABLED=true
REDIS_URL=redis://localhost:6379
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=          ← required for Qdrant Cloud; omit for local Docker Qdrant
QDRANT_COLLECTION=chatbot_chunks
DOCUMENT_STORAGE_PATH=./storage/documents
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
EMBEDDING_DIMENSION=768
EMBEDDING_QUERY_PREFIX=Represent this sentence for searching relevant passages:
EMBEDDING_PROVIDER=huggingface
HUGGINGFACE_API_KEY=your-huggingface-api-token
HUGGINGFACE_API_URL=https://router.huggingface.co/hf-inference
HUGGINGFACE_EMBEDDING_BATCH_SIZE=16
RERANK_ENABLED=false
RAG_TOP_K=20
RAG_RERANK_TOP_K=5
RAG_HYBRID_DENSE_WEIGHT=0.7
RAG_MMR_LAMBDA=0.5
RAG_MAX_UPLOAD_MB=25
INGESTION_MAX_RETRIES=3
INGESTION_MAX_JOBS=3

# Local content guardrails
GUARDRAILS_ENABLED=true
UPLOAD_VALIDATION_GPT_ENABLED=true

# Response routing (documents → general knowledge → web)
RESPONSE_ROUTING_ENABLED=true

# Ingestion isolation (false = fail closed; never embed inside API process)
INGESTION_INLINE_FALLBACK=false

# Observability
METRICS_ENABLED=true
METRICS_TOKEN=
OTEL_ENABLED=true
OTEL_SERVICE_NAME=chatbot-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_CONSOLE_EXPORT=false
