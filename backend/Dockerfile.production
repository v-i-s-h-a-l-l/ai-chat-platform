# Combined API + worker image for Railway (shared volume for uploads).
# Separate API/worker images (Dockerfile / Dockerfile.worker) remain for Render/local.

FROM python:3.12-slim AS base

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    DOCUMENT_STORAGE_PATH=/app/storage/documents \
    HF_HOME=/app/storage/huggingface \
    TRANSFORMERS_CACHE=/app/storage/huggingface \
    SENTENCE_TRANSFORMERS_HOME=/app/storage/huggingface

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app ./app
COPY alembic ./alembic
COPY alembic.ini .
COPY scripts/start_production.sh ./scripts/start_production.sh
RUN chmod +x ./scripts/start_production.sh

EXPOSE 8000

CMD ["./scripts/start_production.sh"]
