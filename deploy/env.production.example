# Copy these to Railway → yellobot-api service → Variables.
# Replace ALL placeholder values before deploying.

ENVIRONMENT=production
PORT=8000

# --- Auto-filled by Railway plugins (do not paste manually) ---
# DATABASE_URL=          ← PostgreSQL plugin
# REDIS_URL=             ← Redis plugin

# --- Required secrets (you must set these) ---
SECRET_KEY=generate-a-long-random-string-at-least-32-chars
GROQ_API_KEY=your-groq-api-key
QDRANT_URL=http://YOUR-CLUSTER.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-cloud-api-key

# --- Frontend URL (set AFTER Vercel deploy — exact origin, no trailing slash) ---
CORS_ORIGINS=https://YOUR-APP.vercel.app

# --- Auth cookies (required for Vercel frontend → Railway API) ---
COOKIE_SECURE=true
COOKIE_SAMESITE=none

# --- Production requirements (enforced by backend/app/config.py) ---
RATE_LIMIT_USE_REDIS=true
INGESTION_INLINE_FALLBACK=false
RAG_ENABLED=true
METRICS_ENABLED=true
METRICS_TOKEN=generate-another-long-random-string

# --- Storage (matches Dockerfile.production + Railway volume mount) ---
DOCUMENT_STORAGE_PATH=/app/storage/documents

# --- Optional ---
# TAVILY_API_KEY=your-tavily-key-for-web-search
# GROQ_MODEL=openai/gpt-oss-120b
INGESTION_MAX_JOBS=2

# --- Vercel only (Project Settings → Environment Variables, all environments) ---
# VITE_API_URL=https://YOUR-SERVICE.up.railway.app
