# Copy these to Render → yellobot-api → Environment (or set during Blueprint sync).
# Replace ALL placeholder values before deploying.

ENVIRONMENT=production
PORT=8000

# --- Auto-filled by Render blueprint ---
# DATABASE_URL=          ← yellobot-postgres
# REDIS_URL=             ← yellobot-redis
# SECRET_KEY=            ← auto-generated (or set manually)
# METRICS_TOKEN=         ← auto-generated (or set manually)

# --- Required secrets (you must set these) ---
GROQ_API_KEY=your-groq-api-key
QDRANT_URL=https://YOUR-CLUSTER.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-cloud-api-key

# --- Frontend URL (set AFTER Vercel deploy — exact origin, no trailing slash) ---
CORS_ORIGINS=https://yellobot.online,https://www.yellobot.online

# --- Auth cookies (required for Vercel frontend → Render API) ---
COOKIE_SECURE=true
COOKIE_SAMESITE=none

# --- Production requirements (enforced by backend/app/config.py) ---
RATE_LIMIT_USE_REDIS=true
INGESTION_INLINE_FALLBACK=false
RAG_ENABLED=true
METRICS_ENABLED=true
DOCUMENT_STORAGE_PATH=/app/storage/documents
INGESTION_MAX_JOBS=2

# --- Embeddings (use Hugging Face API on Render — no local PyTorch) ---
EMBEDDING_PROVIDER=huggingface
HUGGINGFACE_API_KEY=your-huggingface-api-token
HUGGINGFACE_API_URL=https://router.huggingface.co/hf-inference
HUGGINGFACE_EMBEDDING_BATCH_SIZE=16
RERANK_ENABLED=false

EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# --- Vercel only (Project Settings → Environment Variables, all environments) ---
# VITE_API_URL=https://yellobot-api.onrender.com
